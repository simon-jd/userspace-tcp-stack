// Configuration entries owned by m1-tx (SendQueue, RttEstimator, TxPolicy,
// RateState, CC, LossRecovery, process_ack). Only m1-tx adds entries here. No
// include guard: included by config.hpp, config.cpp and defs_test.cpp with the
// macros below defined.
//
//   UTCP_TCP_KNOB(type, name, rfc_value, linux_value, doc)  a TcpConfig field
//   UTCP_STACK_KNOB(type, name, value, doc)                 a StackConfig field
//
// `type` must not contain a top-level comma (use an alias).

// Pacing test knob (DESIGN §5.3): when set, the pacing gate applies with this
// fixed rate in bytes per second, whatever the CC requests.
UTCP_TCP_KNOB(std::optional<std::uint64_t>, test_fixed_pacing_rate, std::nullopt, std::nullopt,
              "fixed pacing rate in bytes/s for tests (DESIGN 5.3)")
